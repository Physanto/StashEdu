            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\": \"Persona Fase 4\",\n  \"documento\": \"F4-{{sufijo}}\",\n  \"email\": \"persona.{{sufijo}}@fase4.edu\",\n  \"tipo_usuario_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
