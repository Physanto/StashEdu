    {
      "name": "1. Documentación: Swagger/OpenAPI",
      "item": [
        {
          "name": "Contrato OpenAPI → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const spec = pm.response.json();",
                  "pm.test(\"Es OpenAPI 3.0.3\", function () { pm.expect(spec.openapi).to.eql(\"3.0.3\"); });",
                  "pm.test(\"Documenta préstamos y login\", function () { pm.expect(spec.paths).to.have.property(\"/api/v1/prestamos\"); pm.expect(spec.paths).to.have.property(\"/api/v1/auth/login\"); });",
                  "pm.test(\"Usa Bearer JWT\", function () { pm.expect(spec.components.securitySchemes.BearerAuth.bearerFormat).to.eql(\"JWT\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{root_url}}/openapi.json",
              "host": [
                "{{root_url}}"
              ],
              "path": [
                "openapi.json"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Swagger UI → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Es la página de Swagger UI\", function () { pm.expect(pm.response.text()).to.include(\"swagger-ui\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{root_url}}/docs/",
              "host": [
                "{{root_url}}"
              ],
              "path": [
                "docs"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
