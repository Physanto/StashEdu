{
  "info": {
    "name": "StashEdu - Fase 4: Calidad y documentación",
    "description": "Manejo de errores HTTP, validación de datos y Swagger/OpenAPI. Antes de ejecutar: crea el primer admin con `flask --app run crear-admin` y escribe su correo y contraseña en admin_email y admin_password. Ejecutar en orden con Run collection; crea sus propios datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_admin}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000/api/v1"
    },
    {
      "key": "root_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "admin_email",
      "value": "admin@uni.edu.co"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "sufijo",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "persona_id",
      "value": ""
    },
    {
      "key": "activo_id",
      "value": ""
    },
    {
      "key": "prestamo_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Preparación",
      "item": [
        {
          "name": "Iniciar sesión (admin) → 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sufijo\", String(Date.now()).slice(-7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"token_admin\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear persona → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"persona_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
