          "name": "Crear activo → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"activo_id\", pm.response.json().id);"
