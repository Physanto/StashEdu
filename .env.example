# Credenciales de una cuenta MySQL/MariaDB con permisos sobre la base de datos
# (usa un usuario propio, no root). Si la contraseña tiene caracteres especiales
# (@ / # :), la librería los codifica sola: escríbela tal cual.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=
DB_NAME=prestamos_activos
FLASK_DEBUG=0
