# Configurar las credenciales de una cuenta MySQL con acceso a la base de datos.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=
DB_NAME=prestamos_activos
FLASK_DEBUG=0
# Generar una clave aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
AUTH_TOKEN_MAX_AGE=3600
# IDs de cuentas existentes que pueden administrar usuarios/activos/préstamos.
# Se concede localmente; el registro público no puede asignar este permiso.
API_OPERATOR_IDS=
